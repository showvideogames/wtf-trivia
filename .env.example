# WTF Trivia configuration. Copy to `.env` (git-ignored) for local work.
# Nothing here is secret: the anon key and the discovery URL are public by
# design. There are NO hosted defaults in code: with the first two unset,
# `npm run dev` runs the offline preview with a built-in demo puzzle.

# The Supabase project the game talks to (puzzles, players, accounts).
#   local stack:  http://127.0.0.1:55621 and its anon key (from `npx supabase status`)
#   hosted beta:  set in Vercel project settings, never committed
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The shared sign-in service's OpenID discovery document.
# Empty = accounts OFF (guest-only build, exactly today's game). The hosted
# beta uses the WorkOS Staging domain, e.g.
# https://<name>.authkit.app/.well-known/openid-configuration
VITE_PLATFORM_DISCOVERY_URL=

# Emergency switch: "false" hides every sign-in surface without a schema change.
# VITE_ACCOUNTS_ENABLED=true

# Puzzle Studio's client-side password (obfuscation, not security; the
# database-enforced admin gate is supabase/migrations/0003_wtf_admin_gate.sql).
VITE_ADMIN_PASSWORD=
