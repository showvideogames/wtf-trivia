{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/archive", "destination": "/index.html" },
    { "source": "/archive/", "destination": "/index.html" },
    { "source": "/stats", "destination": "/index.html" },
    { "source": "/stats/", "destination": "/index.html" },
    { "source": "/how-to-play", "destination": "/index.html" },
    { "source": "/how-to-play/", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/", "destination": "/index.html" },
    { "source": "/streak-lab", "destination": "/index.html" },
    { "source": "/streak-lab/", "destination": "/index.html" },
    { "source": "/auth/callback", "destination": "/index.html" },
    { "source": "/auth/callback/", "destination": "/index.html" },
    { "source": "/s/:code", "destination": "/api/share?code=:code" },
    { "source": "/s/:code/", "destination": "/api/share?code=:code" },
    { "source": "/puzzle/:id", "destination": "/api/puzzle?id=:id" },
    { "source": "/puzzle/:id/", "destination": "/api/puzzle?id=:id" }
  ],
  "headers": [
    {
      "source": "/streak-lab",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/streak-lab/",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
